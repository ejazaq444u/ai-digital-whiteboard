# Server Port
PORT=5000

# JSON Web Token Secret
JWT_SECRET=ai-whiteboard-super-secure-jwt-secret-key-2026
JWT_EXPIRES_IN=7d

# MongoDB Connection String (Falls back gracefully to embedded persistent JSON if offline)
MONGODB_URI=mongodb://127.0.0.1:27017/ai-whiteboard

# Optional AI Handwriting Recognition Keys
# (The built-in offline mathematical parser and grammar engine works 100% out of the box without keys)
GEMINI_API_KEY=
OPENAI_API_KEY=
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Node Environment
NODE_ENV=production
